# LLM Configuration (Default: Local Ollama on GTX 1650)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional Remote Groq API Fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/doc_intelligence
REDIS_URL=redis://localhost:6379/0

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# App Settings
UPLOAD_DIR=./uploads
JWT_SECRET=super-secret-doc-intel-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
